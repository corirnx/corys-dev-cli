{
  "name": "corys-dev-cli",
  "version": "1.0.0",
  "description": "Cory's personal developer CLI for multi-agent repository maintenance and audits",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "corys-dev": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "check": "tsx src/index.ts check",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "@types/diff": "^7.0.2",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "diff": "^9.0.0",
    "dotenv": "^18.0.5",
    "ora": "^8.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
